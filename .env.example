# Gemini API Key (Generate one at Google AI Studio)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini model settings (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-3.1-flash-lite

# RAG configurations (Optional, standard defaults are configured)
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=200
# RAG_COLLECTION_NAME=trade_gpt_reports
